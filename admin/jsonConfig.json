{
  "type": "tabs",
  "i18n": true,
  "items": {
    "account": {
      "type": "panel",
      "label": {
        "de": "1. Xiaomi-Konto",
        "en": "1. Xiaomi account"
      },
      "items": {
        "_setupHeader": {
          "type": "header",
          "text": {
            "de": "Einrichtung in drei Schritten",
            "en": "Setup in three steps"
          },
          "size": 4,
          "sm": 12,
          "newLine": true
        },
        "_setupStep1": {
          "type": "staticText",
          "text": {
            "de": "1. Hier mit dem Xiaomi-Konto anmelden. Das ist nur einmal nötig, die Sitzung wird gespeichert.",
            "en": "1. Sign in with the Xiaomi account here. This is needed only once; the session is stored."
          },
          "sm": 12,
          "newLine": true,
          "style": {
            "fontSize": "16px",
            "lineHeight": "1.6",
            "color": "inherit"
          }
        },
        "_setupStep2": {
          "type": "staticText",
          "text": {
            "de": "2. Im Reiter „2. Roboter“ den Roboter aktivieren, seine IP-Adresse eintragen und „Token und DID aus der Xiaomi-Cloud holen“ klicken.",
            "en": "2. On the tab “2. Robots”, enable the robot, enter its IP address and click “Get token and DID from Xiaomi Cloud”."
          },
          "sm": 12,
          "newLine": true,
          "style": {
            "fontSize": "16px",
            "lineHeight": "1.6",
            "color": "inherit"
          }
        },
        "_setupStep3": {
          "type": "staticText",
          "text": {
            "de": "3. Speichern. Zeitpläne und weitere Optionen stehen im Reiter „3. Optionen“.",
            "en": "3. Save. Schedules and further options are on the tab “3. Options”."
          },
          "sm": 12,
          "newLine": true,
          "style": {
            "fontSize": "16px",
            "lineHeight": "1.6",
            "color": "inherit"
          }
        },
        "_accountHeader": {
          "type": "header",
          "text": {
            "de": "Anmeldung",
            "en": "Sign-in"
          },
          "size": 5,
          "sm": 12,
          "newLine": true
        },
        "cloudUsername": {
          "type": "text",
          "label": {
            "de": "Xiaomi-Konto – E-Mail, Telefonnummer oder Konto-ID",
            "en": "Xiaomi account – e-mail, phone number or account ID"
          },
          "help": {
            "de": "Dasselbe Konto wie in der Xiaomi-Home- bzw. Roidmi-App.",
            "en": "The same account as in the Xiaomi Home or Roidmi app."
          },
          "sm": 12,
          "newLine": true,
          "md": 6
        },
        "cloudPassword": {
          "type": "password",
          "label": {
            "de": "Xiaomi-Konto – Passwort",
            "en": "Xiaomi account – password"
          },
          "help": {
            "de": "Wird von ioBroker verschlüsselt gespeichert.",
            "en": "Stored encrypted by ioBroker."
          },
          "sm": 12,
          "md": 6
        },
        "cloudCountry": {
          "type": "select",
          "label": {
            "de": "Server-Region des Kontos",
            "en": "Account server region"
          },
          "default": "de",
          "options": [
            {
              "label": {
                "de": "Europa (de)",
                "en": "Europe (de)"
              },
              "value": "de"
            },
            {
              "label": {
                "de": "China (cn)",
                "en": "China (cn)"
              },
              "value": "cn"
            },
            {
              "label": {
                "de": "USA (us)",
                "en": "USA (us)"
              },
              "value": "us"
            },
            {
              "label": {
                "de": "Russland (ru)",
                "en": "Russia (ru)"
              },
              "value": "ru"
            },
            {
              "label": {
                "de": "Singapur (sg)",
                "en": "Singapore (sg)"
              },
              "value": "sg"
            },
            {
              "label": {
                "de": "Indien (in)",
                "en": "India (in)"
              },
              "value": "in"
            },
            {
              "label": {
                "de": "Taiwan (tw)",
                "en": "Taiwan (tw)"
              },
              "value": "tw"
            },
            {
              "label": {
                "de": "i2",
                "en": "i2"
              },
              "value": "i2"
            }
          ],
          "help": {
            "de": "Wie in der App unter Profil › Einstellungen › Region; für Deutschland meist Europa.",
            "en": "As shown in the app under profile › settings › region; for Germany usually Europe."
          },
          "sm": 12,
          "newLine": true,
          "md": 6
        },
        "cloudStartLogin": {
          "type": "sendTo",
          "command": "cloudStartLogin",
          "label": {
            "de": "Code anfordern",
            "en": "Request code"
          },
          "jsonData": "{\"username\":\"${data.cloudUsername}\",\"password\":\"${data.cloudPassword}\",\"country\":\"${data.cloudCountry}\",\"token\":\"${data.token}\"}",
          "showProcess": true,
          "icon": "auth",
          "result": {
            "de": "Erledigt – Meldung unten unter „Status“ beachten.",
            "en": "Done – see the status message below."
          },
          "help": {
            "de": "Xiaomi schickt einen Bestätigungscode per E-Mail oder SMS. Ist das Konto auf diesem Gerät schon bekannt, meldet der Adapter direkt die erfolgreiche Anmeldung.",
            "en": "Xiaomi sends a verification code by e-mail or SMS. If the account is already trusted, the adapter reports a successful sign-in right away."
          },
          "variant": "contained",
          "controlStyle": {
            "minHeight": "44px",
            "fontWeight": 600
          },
          "timeout": 60000,
          "sm": 12,
          "newLine": true
        },
        "_cloudVerificationCode": {
          "type": "password",
          "label": {
            "de": "Bestätigungscode aus E-Mail oder SMS",
            "en": "Verification code from e-mail or SMS"
          },
          "help": {
            "de": "Wird nicht gespeichert.",
            "en": "Not stored."
          },
          "sm": 12,
          "newLine": true,
          "md": 6
        },
        "cloudSubmitCode": {
          "type": "sendTo",
          "command": "cloudSubmitCode",
          "label": {
            "de": "Code prüfen und anmelden",
            "en": "Verify code and sign in"
          },
          "jsonData": "{\"username\":\"${data.cloudUsername}\",\"password\":\"${data.cloudPassword}\",\"country\":\"${data.cloudCountry}\",\"token\":\"${data.token}\",\"code\":\"${data._cloudVerificationCode}\"}",
          "showProcess": true,
          "icon": "auth",
          "result": {
            "de": "Bestätigung abgeschlossen.",
            "en": "Verification completed."
          },
          "help": {
            "de": "Schließt die Anmeldung ab. Die Sitzung wird gespeichert; danach weiter im Reiter „2. Roboter“.",
            "en": "Completes sign-in. The session is stored; continue on the tab “2. Robots”."
          },
          "variant": "contained",
          "controlStyle": {
            "minHeight": "44px",
            "fontWeight": 600
          },
          "timeout": 60000,
          "sm": 12,
          "newLine": true
        },
        "cloudStatus": {
          "type": "state",
          "label": {
            "de": "Status",
            "en": "Status"
          },
          "oid": "evePlus.map.cloudStatus",
          "sm": 12,
          "newLine": true
        }
      }
    },
    "robots": {
      "type": "panel",
      "label": {
        "de": "2. Roboter",
        "en": "2. Robots"
      },
      "items": {
        "_eveHeader": {
          "type": "header",
          "text": {
            "de": "Roidmi EVE Plus",
            "en": "Roidmi EVE Plus"
          },
          "size": 5,
          "sm": 12,
          "newLine": true
        },
        "enableRoidmi": {
          "type": "checkbox",
          "label": {
            "de": "Roidmi EVE Plus aktivieren",
            "en": "Enable Roidmi EVE Plus"
          },
          "default": true,
          "sm": 12,
          "newLine": true
        },
        "host": {
          "type": "text",
          "label": {
            "de": "Roidmi EVE Plus – IP-Adresse",
            "en": "Roidmi EVE Plus – IP address"
          },
          "default": "",
          "help": {
            "de": "Lokale IPv4-Adresse, siehe Geräteliste des Routers. Am besten fest zuweisen.",
            "en": "Local IPv4 address, see the router's device list. Preferably a fixed assignment."
          },
          "sm": 12,
          "newLine": true,
          "hidden": "!data.enableRoidmi",
          "md": 6
        },
        "tokenFromCloud": {
          "type": "sendTo",
          "command": "cloudFetchToken",
          "useNative": true,
          "label": {
            "de": "Token und DID aus der Xiaomi-Cloud holen",
            "en": "Get token and DID from Xiaomi Cloud"
          },
          "jsonData": "{\"robot\":\"evePlus\",\"did\":\"${data.did}\",\"host\":\"${data.host}\",\"country\":\"${data.cloudCountry}\"}",
          "showProcess": true,
          "icon": "auth",
          "result": {
            "de": "Token (und DID) eingetragen. Zum Übernehmen speichern.",
            "en": "Token (and DID) filled in. Save to apply."
          },
          "help": {
            "de": "Setzt die Anmeldung im Reiter „1. Xiaomi-Konto“ voraus. Findet den Roboter über die IP-Adresse (oder die DID) und trägt Token und DID unten ein. Danach speichern. Auch nach einem WLAN-Wechsel des Roboters nötig, weil Xiaomi dann einen neuen Token vergibt.",
            "en": "Requires the sign-in on the tab “1. Xiaomi account”. Finds the robot by its IP address (or DID) and fills in token and DID below. Then save. Also needed after the robot's WLAN was changed, because Xiaomi then issues a new token."
          },
          "sm": 12,
          "newLine": true,
          "hidden": "!data.enableRoidmi"
        },
        "did": {
          "type": "text",
          "label": {
            "de": "Roidmi EVE Plus – Geräte-DID",
            "en": "Roidmi EVE Plus – device DID"
          },
          "default": "",
          "help": {
            "de": "Wird vom Knopf oben eingetragen.",
            "en": "Filled in by the button above."
          },
          "sm": 12,
          "newLine": true,
          "hidden": "!data.enableRoidmi",
          "md": 6
        },
        "token": {
          "type": "password",
          "label": {
            "de": "Roidmi EVE Plus – MIoT-/miIO-Token",
            "en": "Roidmi EVE Plus – MIoT / miIO token"
          },
          "help": {
            "de": "Wird vom Knopf oben eingetragen und von ioBroker verschlüsselt gespeichert. Geheim halten.",
            "en": "Filled in by the button above and stored encrypted by ioBroker. Keep it secret."
          },
          "hidden": "!data.enableRoidmi",
          "sm": 12,
          "md": 6
        },
        "_x20Header": {
          "type": "header",
          "text": {
            "de": "Xiaomi X20+",
            "en": "Xiaomi X20+"
          },
          "size": 5,
          "sm": 12,
          "newLine": true
        },
        "enableXiaomi": {
          "type": "checkbox",
          "label": {
            "de": "Xiaomi X20+ aktivieren",
            "en": "Enable Xiaomi X20+"
          },
          "default": false,
          "sm": 12,
          "newLine": true
        },
        "xiaomiHost": {
          "type": "text",
          "label": {
            "de": "Xiaomi X20+ – IP-Adresse",
            "en": "Xiaomi X20+ – IP address"
          },
          "default": "",
          "help": {
            "de": "Lokale IPv4-Adresse, siehe Geräteliste des Routers. Am besten fest zuweisen.",
            "en": "Local IPv4 address, see the router's device list. Preferably a fixed assignment."
          },
          "sm": 12,
          "newLine": true,
          "hidden": "!data.enableXiaomi",
          "md": 6
        },
        "xiaomiTokenFromCloud": {
          "type": "sendTo",
          "command": "cloudFetchToken",
          "useNative": true,
          "label": {
            "de": "Token und DID aus der Xiaomi-Cloud holen",
            "en": "Get token and DID from Xiaomi Cloud"
          },
          "jsonData": "{\"robot\":\"x20Plus\",\"did\":\"${data.xiaomiDid}\",\"host\":\"${data.xiaomiHost}\",\"country\":\"${data.cloudCountry}\"}",
          "showProcess": true,
          "icon": "auth",
          "result": {
            "de": "Token (und DID) eingetragen. Zum Übernehmen speichern.",
            "en": "Token (and DID) filled in. Save to apply."
          },
          "help": {
            "de": "Setzt die Anmeldung im Reiter „1. Xiaomi-Konto“ voraus. Findet den Roboter über die IP-Adresse (oder die DID) und trägt Token und DID unten ein. Danach speichern. Auch nach einem WLAN-Wechsel des Roboters nötig, weil Xiaomi dann einen neuen Token vergibt.",
            "en": "Requires the sign-in on the tab “1. Xiaomi account”. Finds the robot by its IP address (or DID) and fills in token and DID below. Then save. Also needed after the robot's WLAN was changed, because Xiaomi then issues a new token."
          },
          "sm": 12,
          "newLine": true,
          "hidden": "!data.enableXiaomi"
        },
        "xiaomiDid": {
          "type": "text",
          "label": {
            "de": "Xiaomi X20+ – Geräte-DID",
            "en": "Xiaomi X20+ – device DID"
          },
          "default": "",
          "help": {
            "de": "Wird vom Knopf oben eingetragen.",
            "en": "Filled in by the button above."
          },
          "sm": 12,
          "newLine": true,
          "hidden": "!data.enableXiaomi",
          "md": 6
        },
        "xiaomiToken": {
          "type": "password",
          "label": {
            "de": "Xiaomi X20+ – MIoT-/miIO-Token",
            "en": "Xiaomi X20+ – MIoT / miIO token"
          },
          "help": {
            "de": "Wird vom Knopf oben eingetragen und von ioBroker verschlüsselt gespeichert. Geheim halten.",
            "en": "Filled in by the button above and stored encrypted by ioBroker. Keep it secret."
          },
          "hidden": "!data.enableXiaomi",
          "sm": 12,
          "md": 6
        },
        "_pollHeader": {
          "type": "header",
          "text": {
            "de": "Abfrage",
            "en": "Polling"
          },
          "size": 5,
          "sm": 12,
          "newLine": true
        },
        "pollIntervalSeconds": {
          "type": "number",
          "label": {
            "de": "Abfrageintervall (Sekunden)",
            "en": "Polling interval (seconds)"
          },
          "min": 5,
          "max": 3600,
          "default": 30,
          "sm": 12,
          "newLine": true,
          "md": 6
        }
      }
    },
    "options": {
      "type": "panel",
      "label": {
        "de": "3. Optionen",
        "en": "3. Options"
      },
      "items": {
        "scheduleHeading": {
          "type": "header",
          "text": {
            "de": "Zeitpläne automatisch abrufen",
            "en": "Automatically retrieve schedules"
          },
          "size": 5,
          "sm": 12,
          "newLine": true
        },
        "scheduleAutoRefresh": {
          "type": "checkbox",
          "label": {
            "de": "Roidmi EVE Plus – automatisch abrufen",
            "en": "Roidmi EVE Plus – retrieve automatically"
          },
          "default": false,
          "help": {
            "de": "Ruft die gespeicherten Reinigungszeitpläne regelmäßig lokal direkt vom Roidmi EVE Plus ab. Standardmäßig ausgeschaltet.",
            "en": "Periodically retrieves saved cleaning schedules directly from the Roidmi EVE Plus over the local connection. Disabled by default."
          }
        },
        "scheduleRefreshIntervalMinutes": {
          "type": "number",
          "label": {
            "de": "Roidmi EVE Plus – Abrufintervall (Minuten)",
            "en": "Roidmi EVE Plus – refresh interval (minutes)"
          },
          "min": 5,
          "max": 1440,
          "default": 60,
          "help": {
            "de": "Zeit zwischen automatischen Abrufen (5 bis 1440 Minuten).",
            "en": "Time between automatic refreshes (5 to 1440 minutes)."
          }
        },
        "xiaomiScheduleAutoRefresh": {
          "type": "checkbox",
          "label": {
            "de": "Xiaomi X20+ – automatisch abrufen",
            "en": "Xiaomi X20+ – retrieve automatically"
          },
          "default": false,
          "help": {
            "de": "Ruft die gespeicherten Reinigungszeitpläne regelmäßig über die Xiaomi-Cloud ab. Eine aktive Xiaomi-Cloud-Anmeldung ist erforderlich. Standardmäßig ausgeschaltet.",
            "en": "Periodically retrieves saved cleaning schedules through Xiaomi Cloud. An active Xiaomi Cloud login is required. Disabled by default."
          }
        },
        "xiaomiScheduleRefreshIntervalMinutes": {
          "type": "number",
          "label": {
            "de": "Xiaomi X20+ – Abrufintervall (Minuten)",
            "en": "Xiaomi X20+ – refresh interval (minutes)"
          },
          "min": 5,
          "max": 1440,
          "default": 60,
          "help": {
            "de": "Zeit zwischen automatischen Abrufen (5 bis 1440 Minuten).",
            "en": "Time between automatic refreshes (5 to 1440 minutes)."
          }
        },
        "_cloudOptHeader": {
          "type": "header",
          "text": {
            "de": "Xiaomi-Cloud-Funktionen",
            "en": "Xiaomi Cloud features"
          },
          "size": 5,
          "sm": 12,
          "newLine": true
        },
        "cloudEnabled": {
          "type": "checkbox",
          "label": {
            "de": "Roidmi EVE Plus – Karte und Räume aus der Xiaomi-Cloud laden",
            "en": "Roidmi EVE Plus – load map and rooms from Xiaomi Cloud"
          },
          "default": false,
          "help": {
            "de": "Erlaubt evePlus.control.refreshMap. Die lokale Steuerung funktioniert auch ohne.",
            "en": "Enables evePlus.control.refreshMap. Local control works without it."
          },
          "sm": 12,
          "newLine": true
        },
        "cloudControlEnabled": {
          "type": "checkbox",
          "label": {
            "de": "Roidmi EVE Plus – Steuerbefehle über die Xiaomi-Cloud senden",
            "en": "Roidmi EVE Plus – send control commands via Xiaomi Cloud"
          },
          "default": false,
          "help": {
            "de": "Nur bei Problemen mit der lokalen Steuerung. Statusabfragen bleiben lokal.",
            "en": "Only if local control has problems. Status polling remains local."
          },
          "sm": 12,
          "newLine": true
        }
      }
    }
  }
}
